<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DisasterAlleviationFoundation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" />

    <style>    
          
    </style>
</head>
<body>
    <header>
        <nav>
            <div class="navContent">
                <div class="brandName">
                    <img class="brandLogo" src="~/images/logo.png"/>
                </div>
                <div class="links">
                   
                    <ul>

                        <li>
                            <a asp-area="" asp-page="/Index"> HOME     </a>
                        </li>
                        <li>
                         <a class="heading" id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">DONATE </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
                            <a class="dropdown-item" asp-area="" asp-page="/DisasterAdd">ADD DISASTER</a>
                            <a class="dropdown-item" asp-area="" asp-page="/MoneyDonations">MONETARY DONATIONS</a>
                             <a class="dropdown-item" asp-area="" asp-page="/DonateGoods">GOODS DONATIONS</a>
                         </div>
                         </li>
                        <li>

                            <a asp-area="" asp-page="/AboutUs">  ABOUT US  </a>
                        </li>
                        <li>

                            <a  asp-area="" asp-page="/ContactUs"> CONTACT US      </a>
                        </li>

                    </ul>

                </div>
                    
              </div>
        
        </nav>






      
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2022 - DisasterAlleviationFoundation - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
