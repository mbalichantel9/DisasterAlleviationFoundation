@page
@model DisasterAlleviationFoundation.Pages.LogModel
@{
}


<!DOCTYPE html>

<html>

<head>
    <title>Register</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="images/TheDiaryLogo.jpg">

    <style>
        body {
            background-image: url('images/LOGINWALL.jpg');
            background-repeat: no-repeat;
            background-size: cover;
        }

        .form {
            height: 500px;
            color: coral;
            width: 50%;
            height: 85%;
            background-color: white;
            margin-top: 10%;
            margin-left: 23%;
            border: 2px solid #4c00b0;
            color: black;
            box-shadow: 0 0 20px 2px black;
        }

        h1 {
            margin-left: 200px;
            margin-bottom: 12px;
            margin-bottom: 40px;
            color: orange;
            font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
            font-weight: 200;
            letter-spacing: 5px;
        }

        .inputs {
            margin: 30px auto;
            width: 80%;
            border-bottom: 1px solid black;
            padding-top: 10px;
            padding-bottom: 5px;
            color: black;
        }

        inputs input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            color: yellow;
        }

        .inputs .userName,
        .inputs .password,
        .inputs .name,
        .inputs .userName,
        .inputs .userType,
        .inputs .password,
        .inputs .confirmpassword {
            outline: none;
            background: transparent;
            color: black;
            width: 200px;
            border: none;
        }


        ::placeholder {
            color: black;
            font-size: 20px;
        }

        .passwordEye {
            position: absolute;
        }

        #showPassword {
            display: none;
        }

        .forgotPassword {
            color: coral;
            margin-left: 55px;
        }

            .forgotPassword:hover {
                color: purple;
                cursor: pointer;
                text-decoration: underline;
            }


     
        .btn-outline-primary {
            margin: 40px auto 20px;
            width: 80%;
            height: 40px;
            display: block;
            outline: none;
            color: black;
            font-size: 22px;
            border: 1px solid #4c00b0;
            border-radius: 25px;
            background: #e8bcf0;
        }

            
            .btn-outline-primary:hover{
                background-color: darkorchid;
                color: #e8bcf0;
                border: 1px solid #e8bcf0;
            }

        .signup {
            color: black;
            font-size: 18px;
            text-transform: uppercase;
            margin-left: 55px;
        }

            .signup a {
                text-decoration: none;
                color: coral;
            }

                .signup a:hover {
                    text-decoration: underline;
                    color: purple;
                }
    </style>
</head>

<body>

    <form method="post">
        <div class="form">
            <h1> LOGIN</h1>
            <div class="inputs">
                <input class="userName" type="text" name="userEmail" placeholder="Enter Email" id="myUsername" required>
            </div>
            <div class="inputs">
                <input class="password" type="password" name="userPassword" placeholder="Enter Password" id="myPassword" required>
                <span class="passwordEye" onclick="displayPassword()">
                    <i id="showPassword" class="fa fa-eye"></i>
                    <i id="hidePassword" class="fa fa-eye-slash"></i>
                </span>
            </div>
            <div class="forgotPassword">
                Forgot Password?
            </div>
            <button class="btn-outline-primary" value="Submit">LOGIN</button>
         


            <div class="signup">
                <h3>Don't have account? <a asp-area="" asp-page="/Register">SIGN UP</a></h3>

            </div>
        </div>



    </form>

    <script>
        function displayPassword() {
            var x = document.getElementById("myPassword");
            var y = document.getElementById("showPassword");
            var z = document.getElementById("hidePassword");

            if (x.type === 'password') {
                x.type = "text";
                y.style.display = "block";
                z.style.display = "none";
            } else {
                x.type = "password";
                y.style.display = "none";
                z.style.display = "block";
            }
        }
        function success() {

            alert("Successfully Logged In!");


        }


    </script>

</body>


</html>

