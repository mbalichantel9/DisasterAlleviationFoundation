@page
@model DisasterAlleviationFoundation.Pages.ViewGoodsModel
@{ Layout = null;
}

<head>


    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" />

    <style>
        body {
            background-color: plum;
        }

        .containerm {
            min-height: 10vh;
            overflow: hidden;
            width: 100%;
            padding: 2rem;
            display: flex;
            justify-content: center;
            align-items: center
        }

        .btns:hover {
            text-decoration: none;
            background-color: white;
            color: orange;
        }
    </style>
</head>

<header>
    <nav>
        <div class="navContent">
            <div class="brandName">
                <img class="brandLogo" src="~/images/logo.png" />
            </div>
            <div class="links">

                <ul>

                    <li>
                        <a asp-area="" asp-page="/AdminIndex"> HOME     </a>
                    </li>

                    <li>

                        <a asp-area="" asp-page="/Purchases"> PURCHASE GOODS      </a>
                    </li>
                    <li>

                        <a asp-area="" asp-page="/AllocateGoods"> ALLOCATE GOODS      </a>
                    </li>
                    <li>

                        <a asp-area="" asp-page="/Report"> REPORTS      </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>

<div class="containerm">
    <div class="row">
        <div class="col-md-6">
            <a asp-page="/ViewMonetary">
                <div style="background-color: coral; color:white;"> <h3>  VIEW ALL MONETARY DONATIONS</h3></div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewGoods">
                <div style="background-color: coral; color:white;"><h3>   VIEW ALL GOODS DONATIONS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewDisasters">
                <div style="background-color: coral; color:white;">  <h3>  VIEW DISASTERS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewMoney">
                <div style="background-color: coral; color:white;">  <h3>  VIEW AVAILABLE MONEY</h3> </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-page="/PurchasesView">
                <div style="background-color: coral; color:white;">  <h3>  VIEW PURCHASES</h3> </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-page="/ViewAllocations">
                <div style="background-color: coral; color:white;">  <h3>  VIEW ALLOCATIONS</h3> </div>
            </a>
        </div>
    </div>
</div>
<h2>GOODS DONATED</h2>


<div class="container mt-5">

    <div class="row">

        <div class="col-md-8 mx-auto">

            <table class="table bg-plum rounded border">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>GOODS TITLE</th>
                        <th>GOODS QUANTITY</th>
                        <th>GOODS DESCRIPTION</th>
                        <th>GOODS DATE</th>
                        <th>GOODS CATEGORY</th>
                        <th>GOODS DONOR NAME</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var donation in Model.donationList)
                    {
                        <tr>
                            <td>@donation.id</td>
                            <td>@donation.goodsTitle</td>
                            <td>@donation.goodsNo</td>
                            <td>@donation.goodsDescription</td>
                            <td>@donation.goodsDate</td>
                            <td>@donation.goodsCategory</td>

                            <td>@donation.goodsDonorname</td>


                        </tr>
                    }
                    <tr>
                        <td>TOTAL NUMBER OF DONATIONS: </td>
                        <td style="font-weight:bolder; font-size:150%; text-decoration:underline; margin-top:5%">@Model.countGoods()</td>
                    </tr>

                </tbody>


            </table>
        </div>

    </div>


</div>

