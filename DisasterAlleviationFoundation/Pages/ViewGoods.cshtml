@page
@model DisasterAlleviationFoundation.Pages.ViewGoodsModel
@{
}

<style>
  
    .containerm {
        min-height: 10vh;
        overflow: hidden;
        width: 100%;
        padding: 2rem;
        display: flex;
        justify-content: center;
        align-items: center
    }

</style>
<div class="containerm">
    <div class="row">
        <div class="col-md-6">
            <a asp-page="/ViewMonetary">
                <div style="background-color:orange;"> <h3>  VIEW ALL MONETARY DONATIONS</h3></div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewGoods">
                <div style="background-color:orange;"><h3>   VIEW ALL GOODS DONATIONS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewDisasters">
                <div style="background-color:orange;">  <h3>  VIEW DISASTERS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewMoney">
                <div style="background-color:orange;">  <h3>  VIEW AVAILABLE MONEY</h3> </div>
            </a>
        </div>
    </div>
</div>
<h2>VIEW GOODS </h2>
<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>GOOODS TITLE</th>
            <th>GOOODS QUANTITY</th>
            <th>GOOODS DESCRIPTION</th>
            <th>GOOODS DATE</th>
            <th>GOOODS CATEGORY</th>
            <th>GOOODS DONOR NAME</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var donation in Model.donationList)
        {
            <tr>
                <td>@donation.id</td>
                <td>@donation.goodsTitle</td>
                <td>@donation.goodsNo</td>
                <td>@donation.goodsDescription</td>
                <td>@donation.goodsDate</td>
                <td>@donation.goodsCategory</td>
            
                <td>@donation.goodsDonorname</td>

                <td><a class="btn btn-primary btn-sm" href="Delete?id=@donation.id">DELETE</a></td>


            </tr>
        }

    </tbody>


</table>