@page
@model DisasterAlleviationFoundation.Pages.ViewMoneyModel
@{
}

<style>

    body {
        background-color: plum;
    }
    .amountBody {
        width: 90%;
        height: 100px;
        background-color: coral;
        margin: 5%;
    }
    .containerm {
        min-height: 10vh;
        overflow: hidden;
        width: 100%;
        padding: 2rem;
        display: flex;
        justify-content: center;
        align-items: center
    }

</style>


<div class="containerm">
    <div class="row">
        <div class="col-md-6">
            <a asp-page="/ViewMonetary">
                <div style="background-color:orange;"> <h3>  VIEW ALL MONETARY DONATIONS</h3></div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewGoods">
                <div style="background-color:orange;"><h3>   VIEW ALL GOODS DONATIONS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewDisasters">
                <div style="background-color:orange;">  <h3>  VIEW DISASTERS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewMoney">
                <div style="background-color:orange;">  <h3>  VIEW AVAILABLE MONEY</h3> </div>
            </a>
        </div>
    </div>
</div>
<h2>VIEW TOTAL AMOUNT AFTER PURCHASES</h2>
<div class="amountBody">
    
    <table>
        <thead>

            <tr>
                <td>Monetary Donations</td>
                <td>Purchases Amount</td>
                <td>Available Money After Purchases</td>

            </tr>
        </thead>
            <tbody>
        
                <tr>
                    <td>@Model.AvailableMoney</td>
                    <td>@Model.PurchaseMoney</td>
                    <td>@Model.getMoney()</td>
                </tr>
            </tbody>
        
       
    </table>
    


</div>