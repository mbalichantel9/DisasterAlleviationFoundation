@page
@model DisasterAlleviationFoundation.Pages.PurchasesViewModel
@{
}


<style>
    body {
        background-color: plum;
    }

    .containerm {
        min-height: 10vh;
        overflow: hidden;
        width: 100%;
        padding: 2rem;
        display: flex;
        justify-content: center;
        align-items: center
    }
</style>
<div class="containerm">
    <div class="row">
        <div class="col-md-6">
            <a asp-page="/ViewMonetary">
                <div style="background-color: coral; color:white;"> <h3>  VIEW ALL MONETARY DONATIONS</h3></div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewGoods">
                <div style="background-color: coral; color:white;"><h3>   VIEW ALL GOODS DONATIONS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewDisasters">
                <div style="background-color: coral; color:white;">  <h3>  VIEW DISASTERS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewMoney">
                <div style="background-color: coral; color:white;">  <h3>  VIEW AVAILABLE MONEY</h3> </div>
            </a>
        </div>
    </div>
</div>
<h2>PURCHASES</h2>


<div class="container mt-5">

    <div class="row">

        <div class="col-md-8 mx-auto">

            <table class="table bg-plum rounded border">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>ITEM NAME</th>
                        <th>ITEM AMOUNT DATE</th>
                        <th>ITEM CATEGORY</th>
                        <th>ITEM ALLOCATED DISASTER</th>
                        <th>ITEM PURCHASE DATE</th>
                        <th>PURCHASER NAME</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var purchase in Model.purchasesList)
                    {
                        <tr>
                            <td>@purchase.id</td>
                            <td>@purchase.itemName</td>
                            <td>@purchase.itemAmount</td>
                            <td>@purchase.itemCategory</td>
                            <td>@purchase.itemDisaster</td>
                            <td>@purchase.itemPurchaseDate</td>
                            <td>@purchase.itemPurchaserName</td>

                            <td><a class="btn btn-primary btn-sm" href="Delete?id=@purchase.id">DELETE</a></td>


                        </tr>


                    }
                    <tr>
                        <td>TOTAL DONATIONS AMOUNT: </td>
                        <td style="font-weight:bolder; font-size:150%; text-decoration:underline; margin-top:5%">R</td>
                    </tr>


                </tbody>


            </table>
        </div>
    </div>
</div>

