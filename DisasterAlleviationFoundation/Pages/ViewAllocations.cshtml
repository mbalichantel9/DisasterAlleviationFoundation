@page
@model DisasterAlleviationFoundation.Pages.ViewAllocationsModel
@{
}



<style>
    body {
        background-color: plum;
    }

    .containerm {
        min-height: 10vh;
        overflow: hidden;
        width: 100%;
        padding: 2rem;
        display: flex;
        justify-content: center;
        align-items: center
    }
</style>
<div class="containerm">
    <div class="row">
        <div class="col-md-6">
            <a asp-page="/ViewMonetary">
                <div style="background-color: coral; color:white;"> <h3>  VIEW ALL MONETARY DONATIONS</h3></div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewGoods">
                <div style="background-color: coral; color:white;"><h3>   VIEW ALL GOODS DONATIONS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewDisasters">
                <div style="background-color: coral; color:white;">  <h3>  VIEW DISASTERS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewMoney">
                <div style="background-color: coral; color:white;">  <h3>  VIEW AVAILABLE MONEY</h3> </div>
            </a>
        </div>
    </div>
</div>
<h2>ALLOCATIONS</h2>


<div class="container mt-5">

    <div class="row">

        <div class="col-md-8 mx-auto">

            <table class="table bg-plum rounded border">
                <thead>
                    <tr>
                        <th>ALLOCATION ID</th>
                        <th>ALLOCATED GOODS TITLE</th>
                        <th>ALLOCATION GOODS QTY</th>
                        <th>ALLOCATED DISASTER</th>
                      
                    </tr>
                </thead>

                <tbody>

                    @foreach (var allocations in Model.allocationList)
                    {
                        <tr>
                            <td>@allocations.id</td>
                            <td>@allocations.goodsAllocationtitle</td>
                            <td>@allocations.goodsAllocationqty</td>
                            <td>@allocations.goodAllocationdisaster</td>
                            

                            <td><a class="btn btn-primary btn-sm" href="Delete?id=@allocations.id">DELETE</a></td>


                        </tr>


                    }
                    <tr>
                        <td>TOTAL GOODS ALLOCATEDT: </td>
                        <td style="font-weight:bolder; font-size:150%; text-decoration:underline; margin-top:5%"> @Model.getAllocationsTotal()</td>
                    </tr>


                </tbody>


            </table>
        </div>
    </div>
</div>
