@page
@model DisasterAlleviationFoundation.Pages.ViewMonetaryModel
@{ Layout = null;
}

<head>


    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" />


    <style>
        body {
            background-color: plum;
        }

        .containerm {
            min-height: 10vh;
            overflow: hidden;
            width: 100%;
            padding: 2rem;
            display: flex;
            justify-content: center;
            align-items: center
        }
    </style>

</head>
<header>
    <nav>
        <div class="navContent">
            <div class="brandName">
                <img class="brandLogo" src="~/images/logo.png" />
            </div>
            <div class="links">

                <ul>

                    <li>
                        <a asp-area="" asp-page="/AdminIndex"> HOME     </a>
                    </li>

                    <li>

                        <a asp-area="" asp-page="/Purchases"> PURCHASE GOODS      </a>
                    </li>
                    <li>

                        <a asp-area="" asp-page="/AllocateGoods"> ALLOCATE GOODS      </a>
                    </li>
                    <li>

                        <a asp-area="" asp-page="/Report"> REPORTS      </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

</header>

<div class="containerm">
    <div class="row">
        <div class="col-md-6">
            <a asp-page="/ViewMonetary">
                <div style="background-color: coral; color:white;"> <h3>  VIEW ALL MONETARY DONATIONS</h3></div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewGoods">
                <div style="background-color: coral; color:white;"><h3>   VIEW ALL GOODS DONATIONS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewDisasters">
                <div style="background-color: coral; color:white;">  <h3>  VIEW DISASTERS</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/ViewMoney">
                <div style="background-color: coral; color:white;">  <h3>  VIEW AVAILABLE MONEY</h3> </div>
            </a>
        </div>
        <div class="col-md-6">
            <a asp-page="/PurchasesView">
                <div style="background-color: coral; color:white;">  <h3>  VIEW PURCHASES</h3> </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-page="/ViewAllocations">
                <div style="background-color: coral; color:white;">  <h3>  VIEW ALLOCATIONS</h3> </div>
            </a>
        </div>
    </div>
</div>
<h2>MONEY DONATIONS</h2>


<div class="container mt-5">

    <div class="row">

        <div class="col-md-8 mx-auto">

            <table class="table bg-plum rounded border">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>DONATION AMOUNT</th>
                        <th>DONATION DATE</th>
                        <th>DONATED DISASTER</th>
                        <th>DONOR NAME</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var moneyDonation in Model.moneyDonationList)
                    {
                        <tr>
                            <td>@moneyDonation.id</td>
                            <td>R @moneyDonation.donatedAmount</td>
                            <td>@moneyDonation.donatedDate</td>
                            <td>@moneyDonation.donatedDisaster</td>
                            <td>@moneyDonation.donatedPerson</td>

                        </tr>


                    }
                    <tr>
                        <td>TOTAL MONEY DONATIONS AMOUNT: </td>
                        <td style="font-weight:bolder; font-size:150%; text-decoration:underline; margin-top:5%">R @Model.getTotalDonations()</td>
                    </tr>


                </tbody>


            </table>
        </div>
    </div>
</div>
