@page
@model DisasterAlleviationFoundation.Pages.AllocateGoodsModel
@{ Layout = null;
}

<html>

<head>
    <title>Index</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="~/css/styles.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" />
    <style>


        .donationsbody {
            background-image: url('images/paper.jpeg');
            background-repeat: no-repeat;
            background-size: cover;
        }

        .donateimg {
            width: 320px;
            height: 320px;
            margin-left: 70%;
            margin-top: -42%;
            background-color: #ED7117;
        }

        .donationsForm {
            width: 85%;
            height: 95%;
            margin-top: 5%;
            margin-left: 15%;
            color: black;
        }

            .donationsForm h2 {
                margin-left: 8%;
                margin-bottom: 2%;
                border-bottom: 3px solid orange;
                font-size: 35px;
                width: 550px;
                padding-left: 30px;
                letter-spacing: 5px;
                color: white;
                font-weight: 400;
            }

            .donationsForm label {
                color: WHITE;
                font-size: 25px;
                font-weight: 500;
            }

            .donationsForm input,
            .donationsForm .selectgoods,
            .donationsForm .selectname {
                width: 40%;
                outline: none;
                font-weight: 500;
                font-size: 25px;
                background-color: #FDA172;
                color: white;
                outline: none;
                border: 2px solid black;
            }

            .donationsForm .btn-outline-primary {
                width: 40%;
                margin: 15px 0 10px 15px;
                color: white;
                border: none;
                border-radius: 12px;
                font-size: 20px;
                background: #FC6A03;
            }
    </style>
</head>



<body class="donationsbody">

    <header>
        <nav>
            <div class="navContent">
                <div class="brandName">
                    <img class="brandLogo" src="~/images/logo.png" />
                </div>
                <div class="links">

                    <ul>

                        <li>
                            <a asp-area="" asp-page="/AdminIndex"> HOME     </a>
                        </li>

                        <li>

                            <a asp-area="" asp-page="/Purchases"> PURCHASE GOODS      </a>
                        </li>
                        <li>

                            <a asp-area="" asp-page="/AllocateGoods"> ALLOCATE GOODS      </a>
                        </li>
                        <li>

                            <a asp-area="" asp-page="/Report"> REPORTS      </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <form method="post">

        <div class="donationsForm">

            <h2>ALLOCATE GOODS</h2>


            <label> ITEM(S) TITLE TO DONATE</label><br>
            <input type="text" placeholder=" ITEM(S) TITLE " name="goodsAllocationTitle" value="@Model.allocate.goods_allocationtitle" required /><br>

            <label> ITEM(S) QUANTITY</label><br>
            <input type="text" placeholder=" ITEM(S) AMOUNT" name="goodsAllocationQuantity" value="@Model.allocate.goods_allocationqty" required /><br>

            <label> ITEMS CATEGORY</label><br>

            <div class="selectgoods">
                <select class="selectbox" name="goodsAllocationCategory" style="background-color:transparent;width:658px;" aria-label="">
                    <option selected hidden>SELECT ITEMS PURCHASE CATEGORY</option>
                    <option name="itemCategory" value="Clothes">Clothes</option>
                    <option value="Non-Perishable Foods">Non-Perishable Foods</option>
                    <option value="BUILDING MATERIALS">BUILDING MATERIALS</option>
                    <option value="OTHER">OTHER</option>

                </select>
            </div>

            <label>ALLOCATION DATE</label><br>
            <input type="date" placeholder="  DONATION DATE" name="goodsAllocationDate" value="@Model.allocate.goods_allocationdate" required /><br>

            <label>SELECT DISASTER TO ALLOCATE TO TO</label><br>
            <div class="selectDisaster">
                <select name="activeDisaster" style="background-color: #FDA172; width: 658px;">
                    <option class="activeDisasters" selected>CHOOSE ACTIVE DISASTER TO DONATE TO</option>
                    <option value="FLOODS">FLOODS</option>
                    <option value="DRAUGHT">DRAUGHT</option>
                    <option value="TSUNAMI">TSUNAMI</option>
                </select>
            </div>

            <label>ENTER YOUR NAME</label><br>
            <input type="text" placeholder="  ENTER YOUR NAME(OPTIONAL) " name="goodsAllocationDonorname" value="@Model.allocate.goods_allocationdonor" /><br>

            <button class="btn-outline-primary" value="Submit">ALLOCATE GOODS</button>


        </div>
    </form>
    <img class="donateimg" src="~/images/goodspurchase.jfif" />



</body>

</html>